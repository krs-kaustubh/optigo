-- Migration: Add RBI node, split Metro via RBI, rewire Uran feeder, and add walking transfer

-- 1. RBI node (insert only if not exists)
INSERT INTO nodes (name, location, type)
SELECT 'RBI', ST_SetSRID(ST_MakePoint(73.0468000, 19.0217000), 4326), 'metro'
WHERE NOT EXISTS (SELECT 1 FROM nodes WHERE name = 'RBI');

-- If duplicate RBI rows exist, retain the lowest id
DELETE FROM nodes WHERE name = 'RBI' AND id NOT IN (
  SELECT MIN(id) FROM nodes WHERE name = 'RBI'
);

-- 2. Rewire metro: remove old direct edge, insert split via RBI (1.0 km each)
DELETE FROM edges
WHERE from_node = (SELECT id FROM nodes WHERE name='Belapur CBD')
  AND to_node   = (SELECT id FROM nodes WHERE name='Belpada')
  AND mode = 'metro';

DELETE FROM edges
WHERE (from_node = (SELECT id FROM nodes WHERE name='Belapur CBD') AND to_node = (SELECT id FROM nodes WHERE name='RBI'))
   OR (from_node = (SELECT id FROM nodes WHERE name='RBI') AND to_node = (SELECT id FROM nodes WHERE name='Belpada'));

INSERT INTO edges (from_node, to_node, mode, distance, time, cost) VALUES
((SELECT id FROM nodes WHERE name='Belapur CBD'), (SELECT id FROM nodes WHERE name='RBI'),     'metro', 1.0, 2, 4),
((SELECT id FROM nodes WHERE name='RBI'),          (SELECT id FROM nodes WHERE name='Belpada'), 'metro', 1.0, 2, 4);

-- 3. Sagar Sangam topology fix: rewire from Nerul to Seawoods-Darave (3.0 km)
DELETE FROM edges
WHERE from_node = (SELECT id FROM nodes WHERE name='Nerul')
  AND to_node   = (SELECT id FROM nodes WHERE name='Sagar Sangam');

DELETE FROM edges
WHERE from_node = (SELECT id FROM nodes WHERE name='Seawoods-Darave')
  AND to_node   = (SELECT id FROM nodes WHERE name='Sagar Sangam');

INSERT INTO edges (from_node, to_node, mode, distance, time, cost) VALUES
((SELECT id FROM nodes WHERE name='Seawoods-Darave'), (SELECT id FROM nodes WHERE name='Sagar Sangam'), 'train', 3.0, 3, 5);

-- 4. Walking transfer (Belpada ↔ Kharghar, 0.6 km)
DELETE FROM edges
WHERE mode = 'walking'
  AND ((from_node = (SELECT id FROM nodes WHERE name='Belpada') AND to_node = (SELECT id FROM nodes WHERE name='Kharghar'))
    OR (from_node = (SELECT id FROM nodes WHERE name='Kharghar') AND to_node = (SELECT id FROM nodes WHERE name='Belpada')));

INSERT INTO edges (from_node, to_node, mode, distance, time, cost) VALUES
((SELECT id FROM nodes WHERE name='Belpada'),  (SELECT id FROM nodes WHERE name='Kharghar'), 'walking', 0.6, 8, 0),
((SELECT id FROM nodes WHERE name='Kharghar'), (SELECT id FROM nodes WHERE name='Belpada'),  'walking', 0.6, 8, 0);